# Docker network shared by bandwidtharr, qBittorrent, and SABnzbd.
# Must already exist.
DOCKER_NETWORK=docker_network_name

# qBittorrent WebUI. Defaults match the binhex/arch-qbittorrentvpn image --
# change host/port if you're running something else.
QBIT_URL=http://binhex-qbittorrentvpn:8080
QBIT_USER=
QBIT_PASS=

# SABnzbd. Defaults match the binhex/arch-sabnzbdvpn image.
SAB_URL=http://binhex-sabnzbdvpn:8080
SAB_API_KEY=

# Optional: cap qBittorrent's upload speed. Off (untouched) unless set --
# leave blank to not manage it at all. Not shown in the web dashboard.
QBIT_UPLOAD_LIMIT_MBPS=
# Optional: a different upload cap to use while on the backup WAN link (see
# WAN failover detection below). Requires QBIT_UPLOAD_LIMIT_MBPS to also be
# set, so there's always a normal value to fall back to.
QBIT_UPLOAD_LIMIT_BACKUP_MBPS=

TOTAL_LIMIT_MBPS=800
LOG_LEVEL=INFO
WEB_PORT=80

# --- WAN failover detection (optional, off by default) ---
# Switches to a lower budget while you're on a backup link (Starlink, 5G,
# etc). See README for how it works. To turn on: set LINK_DETECTOR=public_ip,
# BACKUP_TOTAL_LIMIT_MBPS, and BACKUP_ISP_MATCH below (all three required).
LINK_DETECTOR=none
BACKUP_TOTAL_LIMIT_MBPS=

# Required whenever LINK_DETECTOR=public_ip -- comma-separated,
# case-insensitive substring(s) identifying your backup link's ISP/org/AS
# name. Don't guess it -- see README's "WAN failover detection" section
# for a one-liner to query it directly and a worked example.
BACKUP_ISP_MATCH=

# Optional: post a Slack message on every confirmed failover/recovery.
# Off (blank) by default. Create one via Slack app settings -> Incoming
# Webhooks. The message includes the state transition, budget Mbps
# values, and a UTC timestamp -- never the detected IP/ISP.
SLACK_WEBHOOK_URL=
