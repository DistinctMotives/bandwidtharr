# Docker network that bandwidtharr, qBittorrent, and SABnzbd all share, so
# bandwidtharr can reach them by container name. Must be an existing external network.
DOCKER_NETWORK=docker_network_name

# Defaults below assume the popular binhex/arch-qbittorrentvpn and
# binhex/arch-sabnzbdvpn images -- change the host/port to match your own
# container names if you're running something else.
QBIT_URL=http://binhex-qbittorrentvpn:8080
QBIT_USER=
QBIT_PASS=

SAB_URL=http://binhex-sabnzbdvpn:8080
SAB_API_KEY=

TOTAL_LIMIT_MBPS=800
POLL_INTERVAL_SECONDS=3
MIN_FLOOR_MBPS=40
ACTIVE_THRESHOLD_MBPS=2
PROBE_STEP_MBPS=40
CHANGE_THRESHOLD_FRACTION=0.05
LOG_LEVEL=INFO
WEB_PORT=80

# WAN failover detection (optional) -- swap in a lower total budget when
# on a backup link (Starlink, 5G, etc). Leave LINK_DETECTOR unset/"none" to
# disable (default). See README for details.
LINK_DETECTOR=none
BACKUP_TOTAL_LIMIT_MBPS=
LINK_CHECK_INTERVAL_SECONDS=30
LINK_FAILOVER_CONFIRM_COUNT=2
# Opt-in ISP-name matching instead of the default DNS-only IP-baseline check
# (sends your public IP to IP_LOOKUP_URL on every check):
# PRIMARY_ISP_MATCH=Comcast
# BACKUP_ISP_MATCH=Starlink,T-Mobile
# IP_LOOKUP_URL=http://ip-api.com/json/?fields=isp,org,as
# DNS_LOOKUP_HOST=myip.opendns.com
# DNS_RESOLVER=208.67.222.222
